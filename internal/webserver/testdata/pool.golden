; Managed by CypherPanel — do not edit by hand.
[cyph_alice]
user = cyph_alice
group = cyph_alice
listen = /run/cypherpanel/php-cyph_alice.sock
listen.owner = cyph_alice
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 10s
pm.max_requests = 500
chdir = /
php_admin_value[memory_limit] = 512M
php_admin_value[upload_max_filesize] = 64M
