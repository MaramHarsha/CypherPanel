# CypherPanel control-plane configuration. Copy to cypherd.env and edit.
# Keep this file secret (it holds the master key and DB password).

# ── Required ─────────────────────────────────────────────────────────────────

# The database password (used by both Postgres and cypherd's DATABASE_URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Decrypts every secret at rest (env vars, deploy keys, backup creds, the CA
# key). Generate ONCE and never change it — losing or changing it makes all
# sealed secrets unrecoverable:
#   openssl rand -base64 32
CYPHERD_MASTER_KEY=

# The public hostname operators and agents reach this plane at. Used in the
# plane's TLS certificate SANs and the join command shown in the UI.
CYPHERD_PUBLIC_HOST=panel.example.com

# ── First owner (optional) ───────────────────────────────────────────────────
# Set these to create the owner account on first boot. Leave them BLANK to do
# first-run setup in the browser instead (visit the panel and create the
# account there — first-run-setup.md).
CYPHERD_ADMIN_EMAIL=
CYPHERD_ADMIN_PASSWORD=

# ── Optional (sensible defaults shown) ───────────────────────────────────────
# CYPHERD_HTTP_ADDR=:8080
# CYPHERD_ENROLL_ADDR=:8443
# CYPHERD_NATS_ADDR=:4222
# CYPHERD_SESSION_TTL=24h
# CYPHERD_RUNTIME_LOGS_MAX_AGE=24h
# CYPHERD_RUNTIME_LOGS_MAX_BYTES=536870912
