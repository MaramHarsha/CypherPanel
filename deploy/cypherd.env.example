# CypherPanel control-plane configuration. Copy to cypherd.env and edit.
# Keep this file secret (it holds the master key and DB password).

# ── Required ─────────────────────────────────────────────────────────────────

# The database password (used by both Postgres and cypherd's DATABASE_URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Decrypts every secret at rest (env vars, deploy keys, backup creds, the CA
# key). Generate ONCE and never change it — losing or changing it makes all
# sealed secrets unrecoverable:
#   openssl rand -base64 32
CYPHERD_MASTER_KEY=

# The public hostname operators and agents reach this plane at. Used in the
# plane's TLS certificate SANs and the join command shown in the UI.
CYPHERD_PUBLIC_HOST=panel.example.com

# ── Behind TLS or a reverse proxy ────────────────────────────────────────────

# The browser-facing base URL of the panel — scheme + host + optional port,
# nothing else. Set it whenever TLS terminates in front (Caddy, nginx, a load
# balancer): every link the panel writes to itself is built from it — the
# email-change confirmation link, the GitHub webhook URL, the agent join
# command. Without it the panel advertises http://$CYPHERD_PUBLIC_HOST:8080,
# which is wrong the moment https is in front.
# CYPHERD_PUBLIC_URL=https://panel.example.com

# Comma-separated CIDRs (or bare addresses) of the proxies in front. ONLY from
# a peer inside this list does the panel believe X-Forwarded-For, X-Real-IP or
# an inbound X-Request-Id. Empty (the default) is correct for a panel exposed
# directly; leaving it empty behind a proxy means every client shares one
# rate-limit key, and setting it too wide lets a client choose its own.
# CYPHERD_TRUSTED_PROXIES=10.0.0.0/8,172.18.0.1

# ── Update check ─────────────────────────────────────────────────────────────

# The panel checks a release feed every 6 hours and tells owners once, in the
# inbox, when a newer version exists. It never updates itself (ADR-010).
# Set to "off" to make no outbound request at all.
# CYPHERD_UPDATE_CHECK=on
# CYPHERD_UPDATE_FEED_URL=https://api.github.com/repos/MaramHarsha/CypherPanel/releases/latest

# ── First owner (optional) ───────────────────────────────────────────────────
# Set these to create the owner account on first boot. Leave them BLANK to do
# first-run setup in the browser instead (visit the panel and create the
# account there — first-run-setup.md).
CYPHERD_ADMIN_EMAIL=
CYPHERD_ADMIN_PASSWORD=

# ── Optional (sensible defaults shown) ───────────────────────────────────────
# CYPHERD_HTTP_ADDR=:8080
# CYPHERD_ENROLL_ADDR=:8443
# CYPHERD_NATS_ADDR=:4222
# CYPHERD_SESSION_TTL=24h
# CYPHERD_RUNTIME_LOGS_MAX_AGE=24h
# CYPHERD_RUNTIME_LOGS_MAX_BYTES=536870912
