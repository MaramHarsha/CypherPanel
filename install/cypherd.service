# CypherPanel control plane (cypherd) as a systemd service — the
# binary-on-host install path (no Docker for the plane itself).
#
#   sudo cp cypherd /usr/local/bin/
#   sudo cp install/cypherd.service /etc/systemd/system/
#   sudo mkdir -p /etc/cypherpanel && sudo cp deploy/cypherd.env.example /etc/cypherpanel/cypherd.env
#   sudo $EDITOR /etc/cypherpanel/cypherd.env      # set MASTER_KEY, DATABASE_URL, PUBLIC_HOST
#   sudo systemctl enable --now cypherd
#
# Postgres is a separate dependency (managed, system package, or a container);
# point CYPHERD_DATABASE_URL at it. See docs/dev/deployment.md.

[Unit]
Description=CypherPanel control plane
Documentation=https://github.com/MaramHarsha/cypherpanel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/cypherpanel/cypherd.env
ExecStart=/usr/local/bin/cypherd
Restart=always
RestartSec=5

# Durable state (JetStream WORK stream + runtime logs).
StateDirectory=cypherd
Environment=CYPHERD_DATA_DIR=/var/lib/cypherd

# The upgrade handoff (panel-updates.md §3). The plane's entire power over its
# own version is to write a request file HERE; the swap is performed by
# cypherd-upgrade.service, which runs as root. Joining the group rather than
# naming a UID is what makes this work regardless of which UID DynamicUser
# picked this boot.
#
# Two lines and one directory is the whole increase in install surface, and it
# is a real cost against "adding a tool, not adopting a platform" — accepted
# because the alternative is the operator doing the same steps by hand, less
# carefully, at the moment they are least calm. Omit both and the panel simply
# reports `manual` mode.
SupplementaryGroups=cypherpanel-upgrade
ReadWritePaths=/var/lib/cypherpanel/upgrade
Environment=CYPHERD_UPGRADE_DIR=/var/lib/cypherpanel/upgrade

# Hardening: cypherd needs no special privileges (it is a network service with
# a data dir), so lock it down.
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
