# Copy to .env and adjust. Never commit .env.
# All CypherPanel configuration is environment-driven — no hardcoded paths or endpoints.

# development | production
CYPHER_ENV=development

# CypherCore API
CYPHER_HTTP_ADDR=:8080

# Control-plane datastores (defaults match docker-compose.yml)
CYPHER_DATABASE_URL=postgres://cypher:cypher-dev-only@localhost:5432/cypherpanel?sslmode=disable
CYPHER_REDIS_URL=redis://localhost:6379/0
CYPHER_NATS_URL=nats://localhost:4222

# Auth. REQUIRED in production (startup fails without it); dev falls back to an insecure default.
CYPHER_JWT_SECRET=
CYPHER_ACCESS_TOKEN_TTL=15m
CYPHER_REFRESH_TOKEN_TTL=720h

# CypherAgent (only used by cypher-agent)
CYPHER_AGENT_CORE_ADDR=localhost:9090
# mTLS material — paths are configuration, never compiled in.
CYPHER_AGENT_TLS_CERT=
CYPHER_AGENT_TLS_KEY=
CYPHER_AGENT_TLS_CA=
