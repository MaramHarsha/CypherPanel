# Copy to .env and adjust. Never commit .env.
# All CypherPanel configuration is environment-driven — no hardcoded paths or endpoints.

# development | production
CYPHER_ENV=development

# CypherCore API
CYPHER_HTTP_ADDR=:8080
CYPHER_GRPC_ADDR=:9090

# Agent gRPC mTLS (REQUIRED in production; empty = plaintext gRPC, dev only).
# Generate with: cypher-core pki init && cypher-core pki issue-server --name core
CYPHER_GRPC_TLS_CERT=
CYPHER_GRPC_TLS_KEY=
CYPHER_GRPC_TLS_CLIENT_CA=

# Control-plane datastores (defaults match docker-compose.yml)
CYPHER_DATABASE_URL=postgres://cypher:cypher-dev-only@localhost:5432/cypherpanel?sslmode=disable
CYPHER_REDIS_URL=redis://localhost:6379/0
CYPHER_NATS_URL=nats://localhost:4222
# Optional NATS credentials file (production NATS must not run open)
CYPHER_NATS_CREDS=

# Auth. REQUIRED in production (startup fails without it); dev falls back to an insecure default.
CYPHER_JWT_SECRET=
CYPHER_ACCESS_TOKEN_TTL=15m
CYPHER_REFRESH_TOKEN_TTL=720h

# Secret encryption for recoverable secrets (account DB/FTP passwords, backup
# repository credentials, webhook signing keys). 32 bytes, base64 or hex.
# REQUIRED in production; dev derives one from the JWT secret.
CYPHER_DB_ENCRYPTION_KEY=

# Audit retention in days (0 = keep forever).
CYPHER_AUDIT_RETENTION_DAYS=90

# CypherAgent (only used by cypher-agent)
CYPHER_AGENT_CORE_ADDR=localhost:9090
CYPHER_AGENT_NATS_URL=nats://localhost:4222
CYPHER_AGENT_NATS_CREDS=
# mTLS material — paths are configuration, never compiled in.
CYPHER_AGENT_TLS_CERT=
CYPHER_AGENT_TLS_KEY=
CYPHER_AGENT_TLS_CA=
# Fleet region for grouping and data-residency filtering. Empty = unassigned.
# A re-registering agent that reports no region keeps whatever the panel has.
CYPHER_AGENT_REGION=

# Admin MariaDB DSN — provisions account databases AND dumps them during
# backups. Empty disables both.
CYPHER_AGENT_MARIADB_DSN=
# Virtual-mailbox auth DB (Postfix/Dovecot). Empty disables mailbox provisioning.
CYPHER_AGENT_MAIL_DSN=

# Backup engine. Backups need restic on each managed server; without it the
# agent logs a warning at startup and backup.* tasks fail with a clear reason.
# Override only if restic is not on PATH.
CYPHER_RESTIC_BIN=
# Dump tool override. The agent auto-detects mariadb-dump, then mysqldump.
CYPHER_MYSQLDUMP_BIN=

# Distro path overrides (agent). Every managed location resolves through the
# path layer — set these only when your distro differs from its family default.
# CYPHER_PATH_NGINX_CONF_DIR=
# CYPHER_PATH_PHPFPM_POOL_DIR=
# CYPHER_PATH_HOME_ROOT=
# CYPHER_PATH_SSL_DIR=
# CYPHER_PATH_MAIL_ROOT=
# CYPHER_PATH_DKIM_DIR=
# CYPHER_PATH_RSPAMD_LOCAL_DIR=
# CYPHER_PATH_BACKUP_STAGING_DIR=
